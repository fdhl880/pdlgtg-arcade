{
  "name": "pdlgtg",
  "version": "0.1.0",
  "private": true,
  "description": "pdlgtg — Arcade Gaming Hub dengan kontrol motion HP. 100% Offline & Mobile Ready.",
  "license": "MIT",
  "author": "Patrick Sun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pattssun/pdlgtg.git"
  },
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tv": "open -na 'Google Chrome' --args --user-data-dir=$HOME/.pdlgtg-chrome --no-first-run --no-default-browser-check --autoplay-policy=no-user-gesture-required --new-window https://localhost:8443/",
    "build": "node scripts/prepare-vercel.js && npm run build:menu",
    "build:menu": "esbuild src/menu/index.jsx --bundle --format=esm --outfile=public/menu-react.js --minify",
    "cert": "node scripts/gen-cert.js",
    "test": "node tests/kart-prototype/server.cjs",
    "build:kart-assets": "node games/mario-kart/pipeline/build.mjs",
    "test:kart-browser": "node games/mario-kart/browser-evidence.mjs",
    "test:kart-public": "node games/mario-kart/public-review.mjs",
    "test:unit": "node --test \"core/**/*.test.mjs\" \"games/**/*.test.mjs\" \"tests/kart-prototype/*.test.mjs\"",
    "test:kart-fallback": "node games/mario-kart/public-review.mjs --fallback"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.1",
    "three": "^0.185.1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
